TRADER_ARBITRAGE_DRY_RUN=true
# Optional demo/testnet hosts. Leave production defaults unless running a
# human-gated smoke. Unit tests never call these URLs.
# BINANCE_PORTFOLIO_API_URL=https://papi.binance.com
# OKX_ACCOUNT_API_URL=https://www.okx.com
# BYBIT_ACCOUNT_API_URL=https://api.bybit.com
# BITGET_ACCOUNT_API_URL=https://api.bitget.com
# GATE_ACCOUNT_API_URL=https://api.gateio.ws
# Optional per-venue override applied to both product sessions. Leave empty to
# use the product-correct defaults (for example Binance Portfolio Margin
# wss://fstream.binance.com/pm/ws and Gate's separate spot/futures hosts).
# BINANCE_ORDER_WS_URL=wss://fstream.binance.com/pm/ws
# OKX_ORDER_WS_URL=wss://ws.okx.com:8443/ws/v5/private
# BYBIT_ORDER_WS_URL=wss://stream.bybit.com/v5/private
# BITGET_ORDER_WS_URL=wss://ws.bitget.com/v3/ws/private
# GATE_ORDER_WS_URL=wss://api.gateio.ws/ws/v4
REPORT_TIMEZONE=Asia/Shanghai
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_CLOB_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_DATA_URL=https://data-api.polymarket.com
