OKX_ACCOUNT_API_URL=https://www.okx.com
BITGET_ACCOUNT_API_URL=https://api.bitget.com
BYBIT_ACCOUNT_API_URL=https://api.bybit.com
GATE_ACCOUNT_API_URL=https://api.gateio.ws
ACCOUNT_SNAPSHOT_TTL=3s
ACCOUNT_SNAPSHOT_HTTP_TIMEOUT=8s
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
# Optional Chainlink Data Streams-compatible history proxy for exact window Open backfill.
POLYMARKET_CHAINLINK_HISTORY_URL=
POLYMARKET_CHAINLINK_HISTORY_TOKEN=
POLYMARKET_HTTP_TIMEOUT=8s
POLYMARKET_MARKET_SYNC_INTERVAL=45s
POLYMARKET_POSITION_ACTIVE_TTL=15s
POLYMARKET_POSITION_IDLE_TTL=90s
POLYMARKET_PRICE_RETENTION=48h
POLYMARKET_PRICE_SAMPLE_INTERVAL=5s
ACCOUNT_TOKEN_SECRET=replace-with-a-long-random-secret
# Shared only by account-service and report-service internal RPCs.
REPORT_INTERNAL_TOKEN=replace-with-a-separate-long-random-service-token
ACCOUNT_TOKEN_TTL=12h
ACCOUNT_CREDENTIALS_KEY=0123456789abcdef0123456789abcdef
ACCOUNT_SESSION_COOKIE=sq_session
ACCOUNT_COOKIE_SECURE=false
API_HTTP_ADDRESS=:8080
SYNC_INTERVAL=10m
INSTRUMENT_SYNC_INTERVAL=8h
EXCHANGE_HTTP_TIMEOUT=10s
ENABLED_EXCHANGES=binance,okx,bybit,bitget,gate,hyperliquid
DEVELOPMENT=true
GATEWAY_CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Aggregate market-data HTTP/WebSocket service. Keep the listener on loopback
# and terminate TLS at a reverse proxy for remote browser access.
AGGDATA_HTTP_ADDRESS=127.0.0.1:9093
AGGDATA_RECORDING_DIR=/tmp/marketdata/crypto
AGGDATA_MDS_GATEWAY_URL=ws://127.0.0.1:9443/v1/market-data
MDS_GATEWAY_TOKEN=replace-with-the-private-mds-token
AGGDATA_ALLOWED_ORIGINS=http://localhost:3000
# Optional browser-facing bearer token. WebSocket clients may use ?token=.
AGGDATA_BROWSER_TOKEN=
AGGDATA_MAX_CLIENTS=128
AGGDATA_MAX_SUBSCRIPTIONS_PER_CLIENT=16
AGGDATA_MANIFEST_REFRESH_INTERVAL=1s
AGGDATA_STREAM_INTERVAL=50ms
AGGDATA_HISTORY_WORKERS=1
AGGDATA_HISTORY_RESOLUTION=1m
# Generic fair price derived only from aggorderbook updates.
AGGDATA_FAIRPRICE_ENABLED=true
AGGDATA_FAIRPRICE_DEPTH=20
AGGDATA_FAIRPRICE_LAMBDA_PER_BP=0.10
AGGDATA_FAIRPRICE_IMBALANCE_ALPHA=1
AGGDATA_FAIRPRICE_EWMA_TAU=500ms
AGGDATA_FAIRPRICE_IMPACT_NOTIONAL=0
AGGDATA_FAIRPRICE_VENUE_DOMINANCE_RATIO=0.90
AGGDATA_FAIRPRICE_STREAM_INTERVAL=5ms
AGGDATA_FAIRPRICE_HEARTBEAT=1s
# PostgreSQL recording is optional and never gates realtime readiness.
AGGDATA_FAIRPRICE_PERSIST_ENABLED=true
AGGDATA_FAIRPRICE_SAMPLE_INTERVAL=1s
AGGDATA_FAIRPRICE_RETENTION=24h
AGGDATA_FAIRPRICE_CLEANUP_INTERVAL=5m
AGGDATA_FAIRPRICE_DELETE_BATCH=10000
AGGDATA_FAIRPRICE_DELETE_MAX_BATCHES=20
AGGDATA_FAIRPRICE_DB_TIMEOUT=5s
