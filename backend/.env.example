TRADER_TWAP_CLEANUP_MAX_BATCHES=10
TRADER_ARBITRAGE_SCHEDULE_INTERVAL=100ms
TRADER_ARBITRAGE_SCHEDULE_LEASE=30s
TRADER_ARBITRAGE_SCHEDULE_BATCH=50
TRADER_ARBITRAGE_SCHEDULE_WORKERS=8
