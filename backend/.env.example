TRADER_ARBITRAGE_OBSERVER_INTERVAL=200ms
TRADER_ARBITRAGE_IOC_PROTECTION_TICKS=3
TRADER_ARBITRAGE_IOC_RETRIES=3
TRADER_ARBITRAGE_ORDER_STREAM_ENABLED=true
TRADER_ORDER_STREAM_RECONNECT_INITIAL=250ms
TRADER_ORDER_STREAM_RECONNECT_MAX=30s
TRADER_ORDER_STREAM_HEARTBEAT=15s
TRADER_ORDER_STREAM_STALE=45s
TRADER_ORDER_STREAM_LISTEN_KEY_REFRESH=30m
TRADER_ORDER_STREAM_REST_AUDIT=30s
TRADER_ORDER_STREAM_SESSION_IDLE=5m
