@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(SELF_QUANT_WITH_MDS "@SELF_QUANT_ENABLE_MDS@")
set(SELF_QUANT_WITH_OMS "@SELF_QUANT_ENABLE_OMS@")
set(SELF_QUANT_WITH_STRATEGYFRAME "@SELF_QUANT_ENABLE_STRATEGYFRAME@")
set(SELF_QUANT_WITH_NET "@SELF_QUANT_WITH_NET@")
set(SELF_QUANT_WITH_SIMDJSON "@SELF_QUANT_HAS_SIMDJSON@")
set(SELF_QUANT_WITH_IBKR "@SELF_QUANT_WITH_IBKR@")
set(_SELF_QUANT_PREFIX "${PACKAGE_PREFIX_DIR}")

find_dependency(Threads)
if(SELF_QUANT_WITH_NET)
  find_dependency(OpenSSL)
endif()
if(SELF_QUANT_WITH_MDS)
  find_dependency(yaml-cpp)
  if(SELF_QUANT_WITH_SIMDJSON)
    find_dependency(simdjson CONFIG)
  endif()
endif()
if(SELF_QUANT_WITH_STRATEGYFRAME)
  find_dependency(yaml-cpp)
endif()
if(SELF_QUANT_WITH_IBKR)
  find_dependency(Protobuf)
  if(NOT TARGET self_quant::ibkr_libbid)
    add_library(self_quant::ibkr_libbid STATIC IMPORTED)
    set_target_properties(self_quant::ibkr_libbid PROPERTIES
      IMPORTED_LOCATION "${_SELF_QUANT_PREFIX}/@CMAKE_INSTALL_LIBDIR@/libbid.a")
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/self_quant-targets.cmake")
check_required_components(self_quant)
