# Browser-facing production template. Replace example.com before building.
# These URLs are used by the user's browser, not by the web container.
# Do not point them at the container's 127.0.0.1.
NEXT_PUBLIC_API_BASE_URL=https://example.com
NEXT_PUBLIC_AGGDATA_BASE_URL=https://example.com
NEXT_PUBLIC_AGGDATA_WS_URL=wss://example.com/v1/stream
NEXT_PUBLIC_AGGDATA_FAIRPRICE_PROFILE=
NEXT_PUBLIC_AGGDATA_FAIRPRICE_QUOTE=USDT
# Optional trusted-network token; do not reuse MDS_GATEWAY_TOKEN.
NEXT_PUBLIC_AGGDATA_TOKEN=
