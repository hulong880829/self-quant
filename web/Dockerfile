FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_AGGDATA_BASE_URL
ARG NEXT_PUBLIC_AGGDATA_WS_URL
ARG NEXT_PUBLIC_AGGDATA_TOKEN
ARG NEXT_PUBLIC_AGGDATA_FAIRPRICE_PROFILE
ARG NEXT_PUBLIC_AGGDATA_FAIRPRICE_QUOTE=USDT

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_AGGDATA_BASE_URL=$NEXT_PUBLIC_AGGDATA_BASE_URL \
    NEXT_PUBLIC_AGGDATA_WS_URL=$NEXT_PUBLIC_AGGDATA_WS_URL \
    NEXT_PUBLIC_AGGDATA_TOKEN=$NEXT_PUBLIC_AGGDATA_TOKEN \
    NEXT_PUBLIC_AGGDATA_FAIRPRICE_PROFILE=$NEXT_PUBLIC_AGGDATA_FAIRPRICE_PROFILE \
    NEXT_PUBLIC_AGGDATA_FAIRPRICE_QUOTE=$NEXT_PUBLIC_AGGDATA_FAIRPRICE_QUOTE

RUN test -n "$NEXT_PUBLIC_API_BASE_URL" || (echo "NEXT_PUBLIC_API_BASE_URL is required to build the web image" >&2 && exit 1)
RUN npm run build

EXPOSE 3000
CMD ["npm", "run", "start"]
